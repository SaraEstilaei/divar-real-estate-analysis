# Python & Environment
__pycache__/
*.py[cod]
*$py.class
venv/
.env
.venv/
conda-env/
.ipynb_checkpoints/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/

# All Data (Never commit data to Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Catch-all for heavy dataset formats anywhere
*.csv
*.parquet
*.feather
*.h5
*.xlsx
*.zip
*.tar.gz

# Outputs
outputs/figures/
outputs/maps/
outputs/reports/

# Models
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
